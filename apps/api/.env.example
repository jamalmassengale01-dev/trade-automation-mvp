# ============================================
# SERVER CONFIG
# ============================================
NODE_ENV=development
PORT=3001
API_HOST=0.0.0.0

# ============================================
# DATABASE
# ============================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trade_automation

# ============================================
# REDIS (for BullMQ)
# ============================================
REDIS_URL=redis://localhost:6379

# ============================================
# WEBHOOK SECURITY
# ============================================
WEBHOOK_SECRET=your-secret-key-here-change-in-production

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=debug
LOG_FILE=logs/app.log

# ============================================
# FEATURE FLAGS
# ============================================
ENABLE_MOCK_BROKER=true
ENABLE_SIMULATED_BROKER=true
GLOBAL_KILL_SWITCH=false

# Origins allowed to send cookie-bearing requests (comma-separated).
# Must name each origin explicitly — CORS forbids '*' with credentials.
CORS_ORIGINS=http://localhost:3000

# DEVELOPMENT ONLY — widen one session window to the whole day so the execution
# path can be tested outside the three 30-minute live windows.
# Values: london | nyam | nypm. Ignored entirely when NODE_ENV=production.
# GB_TEST_SESSION=nyam

# ---------------------------------------------------------------------------
# Notifications
# ---------------------------------------------------------------------------
# Where alerts go. Any endpoint accepting a JSON POST works — a Slack or Discord
# incoming webhook, ntfy, Zapier, Make, or your own handler. The payload has a
# `text` field (which Slack, Discord and ntfy render directly) plus structured
# severity / account / title / message / details alongside it.
#
# Leave unset and alerts still reach the notifications table and the log, and
# the server says so loudly at boot — but nothing reaches a phone or inbox.
NOTIFY_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Stripe (billing)
# ---------------------------------------------------------------------------
# Unset, billing routes return 503 and every customer resolves to no
# subscription. The server says so at boot.
STRIPE_SECRET_KEY=
# From `stripe listen` in development, or the endpoint's signing secret in the
# dashboard. Without it the webhook refuses every request — an unverified
# billing webhook is a free-subscription endpoint.
STRIPE_WEBHOOK_SECRET=
# Price IDs from the Stripe dashboard. A tier with no price cannot be sold and
# is returned as purchasable: false.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_FLEET=
# Where Checkout returns the customer.
APP_URL=http://localhost:3000
