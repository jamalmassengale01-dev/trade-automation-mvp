# ============================================
# Backend API Dockerfile (npm workspaces compatible)
# ============================================

FROM node:20-alpine AS builder

# Install build dependencies
RUN apk add --no-cache python3 make g++

WORKDIR /app

# Copy root package files
COPY package*.json ./

# Copy all workspace package.json files
COPY packages/shared-types/package*.json ./packages/shared-types/
COPY apps/api/package*.json ./apps/api/
COPY apps/web/package*.json ./apps/web/

# Install all dependencies using npm workspaces
RUN npm ci --workspaces --include-workspace-root

# Copy source code
COPY packages/shared-types/ ./packages/shared-types/
COPY apps/api/ ./apps/api/

# Build shared types first (dependency for api)
RUN npm run build --workspace=@trade-automation/shared-types

# Build API
RUN npm run build --workspace=@trade-automation/api

# ============================================
# Production stage
# ============================================
FROM node:20-alpine AS production

WORKDIR /app

# Copy root package files
COPY package*.json ./

# Copy workspace package.json files
COPY packages/shared-types/package*.json ./packages/shared-types/
COPY apps/api/package*.json ./apps/api/

# Copy built artifacts
COPY --from=builder /app/packages/shared-types/dist ./packages/shared-types/dist
COPY --from=builder /app/apps/api/dist ./apps/api/dist

# The TypeScript sources ship too, and deliberately.
#
# Every operator command is `tsx src/...` — db:migrate, create-admin,
# fleet:check, tradovate:preflight. Without src these all fail inside the
# container and the documented setup steps in docs/DEPLOY.md cannot be run at
# all. db:migrate additionally reads its schema_*.sql files by __dirname, and
# tsc does not copy .sql into dist, so a dist-only migrate finds no files,
# "skips" all of them and exits 0 — a silent empty database.
#
# tsx is a runtime dependency (not dev) for the same reason.
COPY --from=builder /app/apps/api/src ./apps/api/src

# Install production dependencies only
RUN npm ci --workspaces --include-workspace-root --omit=dev

# Create logs directory
RUN mkdir -p apps/api/logs

# Expose port
EXPOSE 3001

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3001/health || exit 1

# Start the application.
#
# indexHardened, NOT index. src/index.ts is the original scaffold: it mounts
# neither /api/auth nor /api/gb, so against it the dashboard cannot log in and
# every Operations, Fleet and LaunchPad call 404s. The container ran it until
# now, which is why the UI never worked in Docker.
CMD ["node", "apps/api/dist/indexHardened.js"]
