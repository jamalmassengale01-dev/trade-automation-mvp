# ============================================
# Frontend Web Dockerfile (npm workspaces compatible)
# ============================================

FROM node:20-alpine AS builder

WORKDIR /app

# Copy root package files
COPY package*.json ./

# Copy all workspace package.json files
COPY packages/shared-types/package*.json ./packages/shared-types/
COPY apps/api/package*.json ./apps/api/
COPY apps/web/package*.json ./apps/web/

# Install all dependencies using npm workspaces
RUN npm ci --workspaces --include-workspace-root

# Copy source code
COPY packages/shared-types/ ./packages/shared-types/
COPY apps/web/ ./apps/web/

# Build shared types first (dependency for web)
RUN npm run build --workspace=@trade-automation/shared-types

# The API URL the BROWSER will use.
#
# NEXT_PUBLIC_* values are inlined by Next at BUILD time, not read at runtime,
# so this has to be a build arg — setting it in compose `environment:` does
# nothing for a production build, and next.config.js refuses to build without
# it. It must also be an address the browser can reach: the pages are client
# components, so they call the API from the user's machine, where the compose
# service name `api` does not resolve.
ARG NEXT_PUBLIC_API_URL=http://localhost:3001
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL

# Build Next.js app
RUN npm run build --workspace=@trade-automation/web

# ============================================
# Production stage
# ============================================
FROM node:20-alpine AS production

WORKDIR /app

# Copy root package files
COPY package*.json ./

# Copy workspace package.json files
COPY packages/shared-types/package*.json ./packages/shared-types/
COPY apps/web/package*.json ./apps/web/

# Copy built artifacts
COPY --from=builder /app/packages/shared-types/dist ./packages/shared-types/dist
COPY --from=builder /app/apps/web/.next ./apps/web/.next
# apps/web/public must exist in the repo or this COPY fails the build outright —
# git does not track empty directories, so it needs a real file in it
# (apps/web/public/robots.txt). Do not "tidy that away".
COPY --from=builder /app/apps/web/public ./apps/web/public

# Install production dependencies only
RUN npm ci --workspaces --include-workspace-root --omit=dev

# Expose port
EXPOSE 3000

# Start the application
CMD ["npm", "run", "start", "--workspace=@trade-automation/web"]
