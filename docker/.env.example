# Copy to docker/.env before `docker compose up -d`.
#
# This file is read by both the api container and compose itself. Anything
# missing that has no safe default will stop the stack from starting, which is
# the intended behaviour — a trading system running on placeholder secrets is
# worse than one that refuses to boot.

# --- required ---------------------------------------------------------------
POSTGRES_PASSWORD=
# Shared secret in the TradingView webhook URL. Long and random.
WEBHOOK_SECRET=
# Protects the kill-switch endpoint. Long and random, different from the above.
SYSTEM_API_KEY=
# Public origin of the dashboard, for CORS and Stripe redirects.
CORS_ORIGINS=https://edgepilot.example.com
APP_URL=https://edgepilot.example.com
# Public base for generated webhook URLs — must be reachable from TradingView.
WEBHOOK_BASE_URL=https://api.edgepilot.example.com

# --- notifications ----------------------------------------------------------
# Any endpoint accepting a JSON POST (Slack, Discord, ntfy, Zapier). Unset,
# alerts reach the database and the log only.
NOTIFY_WEBHOOK_URL=

# --- billing ----------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_FLEET=

# --- development only -------------------------------------------------------
# Widens one session to the whole day so the pipeline can be exercised outside
# the three 30-minute windows. IGNORED when NODE_ENV=production; leave unset.
# GB_TEST_SESSION=nyam

LOG_LEVEL=info

# --- HTTPS (only needed for `docker compose --profile public up -d`) --------
# Both must point at this server's IP via an A record before first start, or
# certificate issuance fails.
API_DOMAIN=api.edgepilot.example.com
APP_DOMAIN=edgepilot.example.com
ACME_EMAIL=you@example.com
