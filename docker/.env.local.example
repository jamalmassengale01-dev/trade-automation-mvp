# Local preview — copy to docker/.env to see the dashboard in a browser.
#
#   Copy-Item .env.local.example .env
#   docker compose up -d --build
#
# Everything here is deliberately throwaway. For a real deployment use
# .env.example instead, which has no defaults for the secrets.

POSTGRES_PASSWORD=localdevonly
WEBHOOK_SECRET=localdevonly-change-before-any-real-signal
SYSTEM_API_KEY=localdevonly

# Both must be reachable FROM YOUR BROWSER, not from inside Docker.
NEXT_PUBLIC_API_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000
APP_URL=http://localhost:3000
WEBHOOK_BASE_URL=http://localhost:3001

LOG_LEVEL=info
